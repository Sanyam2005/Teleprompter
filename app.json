{
  "expo": {
    "name": "Teleprompter",
    "slug": "Teleprompter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teleprompter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.teleprompter.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Teleprompter uses the camera to record video while you read your script.",
        "NSMicrophoneUsageDescription": "Teleprompter uses the microphone to record audio with your video.",
        "NSPhotoLibraryAddUsageDescription": "Teleprompter saves your finished recordings to your photo library.",
        "NSPhotoLibraryUsageDescription": "Teleprompter saves your finished recordings to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.teleprompter.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Teleprompter uses the camera to record video while you read your script.",
          "microphonePermission": "Teleprompter uses the microphone to record audio with your video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Teleprompter saves your finished recordings to your photo library.",
          "savePhotosPermission": "Teleprompter saves your finished recordings to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26073373-fd9f-4a4d-b695-949adb7e817d"
      }
    }
  }
}
